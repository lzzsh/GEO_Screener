# Required
SECRET_KEY=change-me-to-a-random-string

# Database (default: SQLite in Docker volume, no change needed)
# DATABASE_URL=sqlite+aiosqlite:////data/geo_search.db

# Redis (default: internal Docker service, no change needed)
# REDIS_URL=redis://redis:6379/0

# LLM Provider — fill in your API key and model
# Supports any OpenAI-compatible endpoint (OpenAI, DeepSeek, Qwen, local Ollama, etc.)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
